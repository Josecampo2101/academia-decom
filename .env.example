# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local ni compartas claves secretas.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY
TURNSTILE_EXPECTED_HOSTNAME=localhost
TURNSTILE_TEST_MODE=false

# Solo desarrollo local: para probar Turnstile sin crear un widget real,
# usa ambas claves oficiales de prueba y activa TURNSTILE_TEST_MODE=true.
# No utilices estas claves ni el modo de prueba en producción.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Worker de notificaciones por correo (solo cuando se habilite)
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=Academia DECOM <notificaciones@tu-dominio-verificado>
APP_URL=http://localhost:3000
